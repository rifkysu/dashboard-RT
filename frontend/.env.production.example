# =====================================================================
#  CONTOH ENV FRONTEND UNTUK PRODUCTION
#  Cara pakai di server (SEBELUM build):
#    cp .env.production.example .env.production
#    (ganti <<GANTI_DOMAIN>>)
#    npm run build
#  Vite otomatis membaca .env.production saat `npm run build`. Nilai ini ditanam ke
#  hasil build, jadi kalau diganti harus build ulang.
# =====================================================================

# Alamat API backend sebagaimana dibuka dari browser pengguna (bukan localhost).
# Kalau frontend & backend satu domain lewat Nginx (lihat docs/deploy/nginx.conf.example):
VITE_API_URL=https://<<GANTI_DOMAIN>>/api
