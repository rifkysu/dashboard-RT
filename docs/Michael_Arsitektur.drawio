<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="l1" name="L1 Konteks">
    <mxGraphModel dx="1560" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l1-judul" value="C4 Level 1 · System Context: Aplikasi Biro Umum" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="l1-sub" value="Siapa yang memakai sistem dan sistem lain apa yang terhubung" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="l1-tamu" value="&lt;b style=&quot;font-size:17px&quot;&gt;Tamu&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Pemohon eksternal; login dengan akun Google di kiosk&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="l1-pegawai" value="&lt;b style=&quot;font-size:17px&quot;&gt;Pegawai&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Karyawan dan PIC Kementerian&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="l1-admin" value="&lt;b style=&quot;font-size:17px&quot;&gt;Kabag / Admin&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Pengelola sistem&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="l1-app" value="&lt;b style=&quot;font-size:17px&quot;&gt;Aplikasi Biro Umum&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Layanan Pemeliharaan, Pengadaan, Kendaraan Dinas, dan Ruang Rapat untuk Kementerian Ketenagakerjaan&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="250" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="l1-google" value="&lt;b style=&quot;font-size:17px&quot;&gt;Google (SSO)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Penyedia login OAuth 2.0 untuk tamu&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="170" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="l1-email" value="&lt;b style=&quot;font-size:17px&quot;&gt;Email (SMTP)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Server email: Gmail atau email kantor&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="l1-e0" value="&lt;b&gt;Mengajukan, mengedit, dan membatalkan booking ruang rapat&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="l1-tamu" target="l1-app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l1-e1" value="&lt;b&gt;Mengajukan permintaan, memproses tahapan (PIC), mengelola booking&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l1-pegawai" target="l1-app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l1-e2" value="&lt;b&gt;Mengelola kendaraan, akun, Mode Maintenance, dan riwayat&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="l1-admin" target="l1-app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l1-e3" value="&lt;b&gt;Mengalihkan login tamu dan menukar kode dengan identitas&lt;/b&gt;&lt;div&gt;[HTTPS, OAuth 2.0 PKCE]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.16;entryX=0;entryY=0.5;" edge="1" parent="1" source="l1-app" target="l1-google"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l1-e4" value="&lt;b&gt;Mengirim email konfirmasi, pembatalan, pengingat, reset sandi&lt;/b&gt;&lt;div&gt;[SMTP]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="l1-app" target="l1-email"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="l2" name="L2 Container">
    <mxGraphModel dx="1960" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l2-judul" value="C4 Level 2 · Container: Aplikasi Biro Umum" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="l2-sub" value="Aplikasi dipecah menjadi aplikasi web, API backend, database, dan penyimpanan berkas" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="l2-batas" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Aplikasi Biro Umum&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;[Software System]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="1560" height="530" as="geometry"/></mxCell>
        <mxCell id="l2-tamu" value="&lt;b style=&quot;font-size:17px&quot;&gt;Tamu&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Login Google di kiosk&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="l2-pegawai" value="&lt;b style=&quot;font-size:17px&quot;&gt;Pegawai&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Karyawan dan PIC&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="l2-admin" value="&lt;b style=&quot;font-size:17px&quot;&gt;Kabag / Admin&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Pengelola sistem&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="l2-web" value="&lt;b style=&quot;font-size:17px&quot;&gt;Aplikasi Web&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: React 18, Vite, Tailwind CSS]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Halaman beranda, kiosk tamu, dan aplikasi pegawai di browser&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="260" height="190" as="geometry"/></mxCell>
        <mxCell id="l2-api" value="&lt;b style=&quot;font-size:17px&quot;&gt;API Backend&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: Node.js, Express]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Modular monolith: aturan bisnis, akses, SSE, penjadwal pengingat. Kontrol risiko: R1 ownership, R2 role, R3 email di latar belakang&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="320" height="260" as="geometry"/></mxCell>
        <mxCell id="l2-db" value="&lt;b style=&quot;font-size:17px&quot;&gt;Database&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: PostgreSQL, Prisma]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Data layanan, akun, dan riwayat aktivitas&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="170" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="l2-file" value="&lt;b style=&quot;font-size:17px&quot;&gt;Penyimpanan Berkas&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: disk lokal, folder uploads/]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Dokumen PDF, JPG, PNG&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="400" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="l2-google" value="&lt;b style=&quot;font-size:17px&quot;&gt;Google (SSO)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Login OAuth 2.0 untuk tamu&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="l2-email" value="&lt;b style=&quot;font-size:17px&quot;&gt;Email (SMTP)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Gmail atau email kantor&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="720" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="l2-e0" value="&lt;b&gt;Membuka kiosk dan mengajukan booking&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2105;" edge="1" parent="1" source="l2-tamu" target="l2-web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e1" value="&lt;b&gt;Memakai aplikasi pegawai&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l2-pegawai" target="l2-web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e2" value="&lt;b&gt;Mengelola sistem&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7895;" edge="1" parent="1" source="l2-admin" target="l2-web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e3" value="&lt;b&gt;Memanggil API dan menerima sinyal perubahan&lt;/b&gt;&lt;div&gt;[HTTPS/JSON, SSE]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l2-web" target="l2-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e4" value="&lt;b&gt;Membaca dan menulis data&lt;/b&gt;&lt;div&gt;[SQL, Prisma]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=-0.0385;entryX=0;entryY=0.5;" edge="1" parent="1" source="l2-api" target="l2-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e5" value="&lt;b&gt;Membaca dan menulis dokumen&lt;/b&gt;&lt;div&gt;[sistem berkas]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8462;entryX=0;entryY=0.5;" edge="1" parent="1" source="l2-api" target="l2-file"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e6" value="&lt;b&gt;Mengalihkan login dan menukar kode&lt;/b&gt;&lt;div&gt;[HTTPS, OAuth 2.0 PKCE]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.1875;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l2-api" target="l2-google"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2-e7" value="&lt;b&gt;Mengirim email&lt;/b&gt;&lt;div&gt;[SMTP]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.8438;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l2-api" target="l2-email"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="erdruang" name="ERD Ruang Rapat">
    <mxGraphModel dx="1440" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="erdruang-judul" value="ERD 2: Data Booking Ruang Rapat" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="erdruang-sub" value="PK = kunci utama, FK = foreign key. Garis putus-putus = rujukan tanpa FK (dijaga aplikasi)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="erdruang-guest" value="&lt;b&gt;GUEST_ACCOUNTS  (Tamu)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  id&lt;br&gt;google_sub  (unik)&lt;br&gt;email · nama · foto&lt;br&gt;is_blocked&lt;br&gt;token_version&lt;br&gt;last_login_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="erdruang-rapat" value="&lt;b&gt;RUANG_RAPAT  (Booking)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  id&lt;br&gt;agenda · pic · pic_phone&lt;br&gt;nomor_surat · surat_name&lt;br&gt;surat_status · surat_file_path&lt;br&gt;room  → RUANG_PROFIL.room (tanpa FK)&lt;br&gt;booking_date · end_date&lt;br&gt;start_time · end_time&lt;br&gt;booking_group  (kode pengajuan)&lt;br&gt;FK  guest_id → GUEST_ACCOUNTS.id&lt;br&gt;FK  cancelled_by_guest_id → GUEST_ACCOUNTS.id&lt;br&gt;FK  created_by · updated_by → USERS.id&lt;br&gt;FK  cancelled_by → USERS.id&lt;br&gt;cancelled_at · cancel_reason&lt;br&gt;reminder_h1_at · reminder_jam_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="390" height="290" as="geometry"/></mxCell>
        <mxCell id="erdruang-user" value="&lt;b&gt;USERS  (Pegawai)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  id&lt;br&gt;email  (unik)&lt;br&gt;nama_lengkap&lt;br&gt;role  (karyawan · pic · kabag · admin)&lt;br&gt;unit_kerja · no_hp&lt;br&gt;is_active · token_version" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="erdruang-profil" value="&lt;b&gt;RUANG_PROFIL  (Ruangan)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  room&lt;br&gt;satuan_kerja · kapasitas&lt;br&gt;fasilitas (JSON) · sort_order&lt;br&gt;maintenance · mulai · sampai&lt;br&gt;FK  updated_by → USERS.id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1140" y="500" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="erdruang-riwayat" value="&lt;b&gt;RIWAYAT_AKTIVITAS  (Log)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  id&lt;br&gt;waktu · modul · aksi&lt;br&gt;ref_id · ref_grup  (tanpa FK)&lt;br&gt;aktor_tipe · aktor_id · aktor_nama&lt;br&gt;perubahan (JSON) · keterangan" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#1e3a8a;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="erdruang-catatan" value="Satu pengajuan = satu booking_group = satu atau lebih baris RUANG_RAPAT (rentang tanggal berurutan; tanggal loncat-loncat = beberapa baris).&lt;br&gt;Booking tidak dihapus saat batal: cancelled_at + alasan diisi. Semua FK boleh kosong dan memakai ON DELETE SET NULL." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="1300" height="60" as="geometry"/></mxCell>
