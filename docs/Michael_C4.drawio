        <mxCell id="l2-web" value="&lt;b style=&quot;font-size:17px&quot;&gt;Aplikasi Web&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: React 18, Vite, Tailwind CSS]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Halaman beranda, kiosk tamu, dan aplikasi pegawai di browser&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="260" height="190" as="geometry"/></mxCell>
