  <diagram id="l3a" name="L3 Backend: rute">
    <mxGraphModel dx="2020" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l3a-judul" value="C4 Level 3 · Component: API Backend (rute, middleware, entry)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="l3a-sub" value="Urutan request: Express app → middleware → router per fitur. Layanan bersama ada di diagram berikutnya" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="l3a-web" value="&lt;b style=&quot;font-size:17px&quot;&gt;Aplikasi Web&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: React 18, Vite]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Memanggil API dan menerima SSE&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="l3a-batas" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;API Backend&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;[Container: Node.js, Express]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1670" height="760" as="geometry"/></mxCell>
        <mxCell id="l3a-express" value="&lt;b style=&quot;font-size:16px&quot;&gt;Express app&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: index.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Memasang middleware dan rute /api/*, CORS, batas ukuran body&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="l3a-sec" value="&lt;b style=&quot;font-size:16px&quot;&gt;Middleware keamanan&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: security.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Header keamanan, batas laju, validasi input umum, ID request&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="l3a-auth" value="&lt;b style=&quot;font-size:16px&quot;&gt;Middleware autentikasi&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: middleware/auth.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Verifikasi JWT, peran dari database, requireRole. Kontrol R2&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="260" height="120" as="geometry"/></mxCell>
