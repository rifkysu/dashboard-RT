  <diagram id="l4" name="L4 Kode">
    <mxGraphModel dx="2000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l4-judul" value="C4 Level 4 · Code: modul booking ruang rapat" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="l4-sub" value="Fungsi utama dan siapa memanggil siapa pada alur ajukan, edit, batal, dan pengingat booking" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="l4-guest" value="&lt;b&gt;guest.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · routes/guest.js (Router Tamu)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Fungsi&lt;/b&gt;&lt;br&gt;requireGuest(req, res, next)&lt;br&gt;bacaFormBooking(body, {wajibSurat})&lt;br&gt;cekBentrok(tx, room, ranges, start, end, kecualiIds)&lt;br&gt;batalSebagian(req, res, id, target)&lt;br&gt;decodeIdToken(idToken)&lt;br&gt;&lt;b&gt;Rute&lt;/b&gt;&lt;br&gt;POST /bookings   PUT /bookings/:id&lt;br&gt;POST /bookings/:id/cancel&lt;br&gt;GET /bookings   GET /captcha&lt;br&gt;googleRouter: GET /google, /google/callback" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="430" height="270" as="geometry"/></mxCell>
        <mxCell id="l4-rr" value="&lt;b&gt;ruangRapat.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · routes/ruangRapat.js (Router Ruang Rapat)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Diekspor sebagai booking (dipakai guest.js)&lt;/b&gt;&lt;br&gt;conflictWhere(room, bd, ed, st, et, excludeId)&lt;br&gt;conflictMessage(c)&lt;br&gt;lockRoom(tx, room)&lt;br&gt;pecahPembatalan(tx, members, cancel, opts)&lt;br&gt;dateRuns(list)   suratStatus(fileData)&lt;br&gt;validText · validPhone · validDate · validTime · validFile&lt;br&gt;HttpError(status, message)   out(row)&lt;br&gt;&lt;b&gt;Rute pegawai&lt;/b&gt;&lt;br&gt;POST /   PUT /:id   DELETE /:id&lt;br&gt;POST /:id/cancel-dates   GET /public-schedule" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="470" height="285" as="geometry"/></mxCell>
        <mxCell id="l4-audit" value="&lt;b&gt;audit.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/audit.js&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;catat(req, {modul, aksi, ref, perubahan, keterangan})&lt;br&gt;bandingkan(modul, sebelum, sesudah)   ringkas(modul, row)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="1450" y="250" width="470" height="120" as="geometry"/></mxCell>
        <mxCell id="l4-mail" value="&lt;b&gt;mailer.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/mailer.js (nodemailer)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;isMailConfigured()&lt;br&gt;sendBookingEmail({to, nama, jenis,&lt;br&gt;   rincian, sebelumnya, catatan})&lt;br&gt;sendResetPasswordEmail(...)   sendVerifyEmail(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="1450" y="560" width="470" height="170" as="geometry"/></mxCell>
        <mxCell id="l4-bm" value="&lt;b&gt;bookingMail.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/bookingMail.js&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;emailBooking(guest, jenis, {rincian, sebelumnya, catatan})&lt;br&gt;rincianBooking(rows, extra)   teksTanggal(rows)&lt;br&gt;fmtHari(d)   jam(d)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="470" height="120" as="geometry"/></mxCell>
        <mxCell id="l4-rem" value="&lt;b&gt;reminders.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/reminders.js&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;mulaiPengingat()   jalankanPengingat(sekarang)&lt;br&gt;tentukanPengingat({mulaiMs, dibuatMs, sekarangMs,&lt;br&gt;   sudahH1, sudahJam})  → 'ingat-h1' | 'ingat-jam' | null" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="700" y="830" width="470" height="130" as="geometry"/></mxCell>
        <mxCell id="l4-cap" value="&lt;b&gt;captcha.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/captcha.js&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;createCaptcha(owner)&lt;br&gt;verifyCaptcha(owner, answer)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="l4-rl" value="&lt;b&gt;ruangList.js&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modul · src/ruangList.js&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;ruangValid(room)&lt;br&gt;cekMaintenance(db, room, ranges)&lt;br&gt;daftarRuang()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#3c7fc0;strokeWidth=2;fontSize=12;fontColor=#1b2a3a;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="l4-e0" value="&lt;b&gt;Memanggil conflictWhere, lockRoom, pecahPembatalan, dateRuns, HttpError, validator&lt;/b&gt;&lt;div&gt;[require('./ruangRapat').booking]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4815;entryX=0;entryY=0.4561;" edge="1" parent="1" source="l4-guest" target="l4-rr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e1" value="&lt;b&gt;verifyCaptcha&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.2558;exitY=1;entryX=0.44;entryY=0;" edge="1" parent="1" source="l4-guest" target="l4-cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e2" value="&lt;b&gt;ruangValid, cekMaintenance&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.907;exitY=1;entryX=0.3793;entryY=0;" edge="1" parent="1" source="l4-guest" target="l4-rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e3" value="&lt;b&gt;emailBooking, rincianBooking&lt;/b&gt;&lt;div&gt;[baru, edit, batal]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9259;entryX=0;entryY=0.3333;" edge="1" parent="1" source="l4-guest" target="l4-bm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e4" value="&lt;b&gt;emailBooking&lt;/b&gt;&lt;div&gt;[batal oleh Biro Umum]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l4-rr" target="l4-bm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e5" value="&lt;b&gt;catat() (juga dipakai guest.js)&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6491;entryX=0;entryY=0.4583;" edge="1" parent="1" source="l4-rr" target="l4-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4-e6" value="&lt;b&gt;sendBookingEmail&lt;/b&gt;&lt;div&gt;[panggilan fungsi]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5417;entryX=0;entryY=0.6176;" edge="1" parent="1" source="l4-bm" target="l4-mail"><mxGeometry relative="1" as="geometry"/></mxCell>
