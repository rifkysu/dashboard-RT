        <mxCell id="l3b-batas" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;API Backend&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;[Container: Node.js, Express]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#444444;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="1480" height="600" as="geometry"/></mxCell>
        <mxCell id="l3b-audit" value="&lt;b style=&quot;font-size:15px&quot;&gt;Audit&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: audit.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;catat(): riwayat aktivitas; dipakai semua router data&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="l3b-live" value="&lt;b style=&quot;font-size:15px&quot;&gt;Live (SSE)&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: live.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Bus perubahan, notifyOnWrite, stream sinyal topik&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="160" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="l3b-cache" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cache respons&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: responseCache.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;cacheGet(): cache GET 5 dtk, kosong saat ada perubahan&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="160" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="l3b-mail" value="&lt;b style=&quot;font-size:15px&quot;&gt;Email booking&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: mailer.js, bookingMail.js]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;emailBooking(), sendBookingEmail() lewat nodemailer. Kontrol R3: kirim di latar belakang&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590" y="160" width="260" height="120" as="geometry"/></mxCell>
