        <mxCell id="l1-judul" value="C4 Level 1 · System Context: Aplikasi Biro Umum" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1100" height="34" as="geometry"/></mxCell>
        <mxCell id="l1-sub" value="Siapa yang memakai sistem dan sistem lain apa yang terhubung" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
