        <mxCell id="l3b-sub" value="Modul pendukung yang dipakai lintas router; garis hanya untuk ketergantungan penting" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="24" as="geometry"/></mxCell>
