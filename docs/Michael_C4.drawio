        <mxCell id="l3c-api" value="&lt;b style=&quot;font-size:16px&quot;&gt;Klien API pegawai&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: api.js (axios)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Menyelipkan token JWT pegawai di setiap request&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="800" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="l3c-gapi" value="&lt;b style=&quot;font-size:16px&quot;&gt;Klien API tamu&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: guestApi.js (axios)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Menyelipkan token tamu (Google) di request tamu&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="800" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="l3c-live" value="&lt;b style=&quot;font-size:16px&quot;&gt;Klien SSE&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;i&gt;[Component: live.js, useLive, useRuangRapatLive]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Satu koneksi SSE per tab; memicu refetch saat ada sinyal&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="800" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="l3c-be" value="&lt;b style=&quot;font-size:17px&quot;&gt;API Backend&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Container: Node.js, Express]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;REST /api/* dan stream SSE /api/live/stream&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1620" height="100" as="geometry"/></mxCell>
        <mxCell id="l3c-e0" value="&lt;b&gt;Memakai&lt;/b&gt;&lt;div&gt;[import]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.1605;entryY=0;" edge="1" parent="1" source="l3c-c0" target="l3c-sv"><mxGeometry relative="1" as="geometry"/></mxCell>
