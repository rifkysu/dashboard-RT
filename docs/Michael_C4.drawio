        <mxCell id="l2-google" value="&lt;b style=&quot;font-size:17px&quot;&gt;Google (SSO)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Login OAuth 2.0 untuk tamu&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="l2-email" value="&lt;b style=&quot;font-size:17px&quot;&gt;Email (SMTP)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;i&gt;[Software System (eksternal)]&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px&quot;&gt;Gmail atau email kantor&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="720" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="l2-e0" value="&lt;b&gt;Membuka kiosk dan mengajukan booking&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#707070;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2105;" edge="1" parent="1" source="l2-tamu" target="l2-web"><mxGeometry relative="1" as="geometry"/></mxCell>
