# =====================================================================
#  CONTOH KONFIGURASI NGINX (frontend + backend dalam satu domain)
#  Salin ke /etc/nginx/sites-available/biro-umum, ganti <<GANTI_DOMAIN>>
#  dan path folder, lalu:  sudo nginx -t && sudo systemctl reload nginx
#
#  Pasangannya:
#    backend/.env   -> FRONTEND_URL=https://<<GANTI_DOMAIN>>, TRUST_PROXY=true
#    frontend/.env.production -> VITE_API_URL=https://<<GANTI_DOMAIN>>/api
#
#  Header keamanan halaman web ada di security-headers.conf (di-include di bawah).
#  Salin ke /etc/nginx/snippets/biro-umum-security-headers.conf.
# =====================================================================

# Sembunyikan versi Nginx di header & halaman error.
server_tokens off;

server {
    listen 80;
    server_name <<GANTI_DOMAIN>>;
    # Arahkan ke HTTPS. (Sertifikat bisa dibuat dengan: sudo certbot --nginx -d <<GANTI_DOMAIN>>)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <<GANTI_DOMAIN>>;

    ssl_certificate     /etc/letsencrypt/live/<<GANTI_DOMAIN>>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<<GANTI_DOMAIN>>/privkey.pem;
    # Hanya TLS modern (TLS 1.0/1.1 sudah tidak aman).
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    # Jangan pernah sajikan file tersembunyi (.env, .git, dll.); /.well-known tetap boleh (certbot).
    location ~ /\.(?!well-known) {
        return 404;
    }

    # Backend menerima upload dokumen sampai 25 MB per simpan (Base64 dalam JSON).
    client_max_body_size 30m;

    # --- Frontend: hasil `npm run build` (folder frontend/dist) -------------
    root /var/www/biro-umum-app/frontend/dist;
    index index.html;

    location / {
        # React Router: semua alamat yang bukan file dikembalikan ke index.html
        try_files $uri $uri/ /index.html;
        # index.html jangan di-cache, supaya update aplikasi (dan header di bawah) langsung terpakai.
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/biro-umum-security-headers.conf;
    }

    location /assets/ {
        # Nama file hasil build sudah mengandung hash -> aman di-cache lama
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Nginx tidak mewarisi add_header dari luar bila location punya add_header sendiri -> include lagi.
        include /etc/nginx/snippets/biro-umum-security-headers.conf;
    }

    # --- Realtime (Server-Sent Events) ---------------------------------------
    # Wajib: tanpa ini sinyal realtime tertahan di buffer Nginx dan baru muncul telat.
    # Mencakup /api/live/stream (dipakai aplikasi) dan stream lama /api/*/stream.
    location ~ ^/api/(live|ruang-rapat|maintenance)/stream$ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        # Backend mengirim heartbeat tiap 25 detik; beri batas jauh di atasnya.
        proxy_read_timeout 1h;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # --- API backend -----------------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Export ZIP surat / Excel bisa butuh waktu
        proxy_read_timeout 120s;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
