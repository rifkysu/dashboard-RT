# =====================================================================
#  CONTOH .env BACKEND UNTUK PRODUCTION
#  Cara pakai di server:
#    cp .env.production.example .env
#  lalu ganti semua nilai bertanda <<GANTI>>. Jangan commit file .env.
# =====================================================================

# --- Database (PostgreSQL) -------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DB?schema=public
# Password yang berisi karakter khusus (@ : / # ?) harus di-URL-encode, mis. @ -> %40
DATABASE_URL="postgresql://<<GANTI_USER>>:<<GANTI_PASSWORD>>@127.0.0.1:5432/biro_umum_db?schema=public"

# --- Server ------------------------------------------------------------
PORT="4000"
# Wajib "true" kalau backend ada di belakang Nginx/reverse proxy, supaya rate limit &
# batas koneksi realtime dihitung per IP pengguna, bukan IP proxy.
# Isi "false" HANYA kalau backend diakses langsung tanpa proxy.
TRUST_PROXY="true"
PRISMA_LOG="false"

# --- Alamat frontend ---------------------------------------------------
# Domain tempat pengguna membuka aplikasi. Dipakai untuk CORS, link reset password,
# dan redirect login Google. Tanpa garis miring di akhir. Harus sama persis (http/https, www).
FRONTEND_URL="https://<<GANTI_DOMAIN>>"

# --- Login (JWT) ------------------------------------------------------
# WAJIB acak & minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Kalau diganti, semua pengguna otomatis ter-logout (harus login ulang).
JWT_SECRET="<<GANTI_DENGAN_STRING_ACAK>>"
JWT_EXPIRES_IN="8h"

# --- Login Google / SSO (opsional) ------------------------------------
# Kosongkan ketiganya kalau tidak dipakai.
# Kalau dipakai: tambahkan GOOGLE_CALLBACK_URL yang sama persis ke
# "Authorized redirect URIs" di Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://<<GANTI_DOMAIN>>/api/auth/google/callback"

# --- Email lupa password (opsional) ------------------------------------
# Kosongkan SMTP_HOST kalau belum ada -> permintaan reset masuk ke notifikasi admin
# (menu Akun & Akses). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_PASS = App Password 16 karakter (wajib Verifikasi 2 Langkah aktif).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# MAIL_FROM="Biro Umum <biroumum@kemnaker.go.id>"
