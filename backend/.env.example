# Prisma PostgreSQL connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/biro_umum_db?schema=public"

JWT_SECRET="change-this-to-a-random-string-at-least-32-characters"
JWT_EXPIRES_IN="8h"
FRONTEND_URL="http://localhost:5173"
TRUST_PROXY="false"
PRISMA_LOG="false"

# Optional Google SSO
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Optional: kirim link Lupa Password langsung ke email pengguna.
# Kosongkan SMTP_HOST kalau belum ada -> permintaan reset masuk ke notifikasi admin (menu Akun & Akses).
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=alamat Gmail,
# SMTP_PASS=App Password 16 karakter (https://myaccount.google.com/apppasswords, wajib Verifikasi 2 Langkah aktif).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# MAIL_FROM opsional; default: "Biro Umum" <SMTP_USER>
