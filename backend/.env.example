# ================== KONFIGURASI DATABASE POSTGRESQL ==================
# Sesuaikan dengan koneksi yang kamu buat di pgAdmin4
PGHOST=localhost
PGPORT=5432
PGDATABASE=biro_umum_db
PGUSER=postgres
PGPASSWORD=ISI_PASSWORD_POSTGRES_KAMU

# ================== JWT ==================
# Ganti dengan string acak & rahasia (boleh generate lewat: openssl rand -hex 32)
JWT_SECRET=ganti_dengan_secret_key_yang_panjang_dan_acak
JWT_EXPIRES_IN=8h

# ================== SERVER ==================
PORT=4000
FRONTEND_URL=http://localhost:5173

# ================== SSO GOOGLE (opsional, isi jika ingin aktifkan login SSO) ==================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Security / production
FRONTEND_URL=http://localhost:5173
JWT_SECRET=ganti-dengan-rahasia-random-minimal-32-karakter
JWT_EXPIRES_IN=8h
TRUST_PROXY=false
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
