{
  "name": "biro-umum-backend",
  "version": "1.0.0",
  "description": "Backend API - Layanan Biro Umum & Rumah Tangga",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:test": "node -e \"require('dotenv').config(); const p=require('./src/prisma'); p.$queryRawUnsafe('SELECT now() AS now').then(r=>{console.log(r); return p.$disconnect()}).catch(e=>{console.error(e); process.exit(1)})\"",
    "postinstall": "prisma generate",
    "db:verify": "node scripts/db-verify.js",
    "uploads:cleanup": "node scripts/cleanup-uploads.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.16.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
