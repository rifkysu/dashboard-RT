generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  karyawan
  kabag
  pic
  admin
  @@map("user_role")
}

enum StatusTahap {
  pending
  on_progress
  selesai
  @@map("status_tahap")
}

model User {
  id              Int       @id @default(autoincrement())
  nama_lengkap    String    @db.VarChar(150)
  email           String    @unique @db.VarChar(150)
  password_hash   String?   @db.VarChar(255)
  no_hp           String?   @db.VarChar(30)
  unit_kerja      String?   @db.VarChar(50)
  role            UserRole  @default(karyawan)
  sso_provider    String?   @db.VarChar(30)
  sso_subject     String?   @db.VarChar(255)
  is_active       Boolean   @default(true)
  reset_token         String?   @unique @db.VarChar(128)
  reset_token_expires DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  pemeliharaanCreated Pemeliharaan[] @relation("PemeliharaanCreatedBy")
  pemeliharaanUpdated Pemeliharaan[] @relation("PemeliharaanUpdatedBy")
  pengadaanCreated    Pengadaan[]    @relation("PengadaanCreatedBy")
  pengadaanUpdated    Pengadaan[]    @relation("PengadaanUpdatedBy")
  kendaraanCreated    Kendaraan[]    @relation("KendaraanCreatedBy")
  kendaraanUpdated    Kendaraan[]    @relation("KendaraanUpdatedBy")
  ruangRapatCreated   RuangRapat[]   @relation("RuangRapatCreatedBy")
  ruangRapatUpdated   RuangRapat[]   @relation("RuangRapatUpdatedBy")

  @@map("users")
}

model Pemeliharaan {
  id                    Int          @id @default(autoincrement())
  kode                  String       @unique @db.VarChar(30)
  judul                 String       @db.VarChar(255)
  lokasi                String       @db.VarChar(150)
  titik_lokasi          String?      @db.VarChar(255)
  kategori              String       @db.VarChar(20)
  deskripsi             String?
  request_document_name String?
  request_document_file_data String?
  request_document_file_path String?
  tanggal               DateTime     @default(now()) @db.Date
  status                StatusTahap  @default(pending)
  tanggal_selesai       DateTime?    @db.Date
  tahap1_status         StatusTahap  @default(pending)
  tahap2_status         StatusTahap  @default(pending)
  tahap3_status         StatusTahap  @default(pending)
  jenis_pekerjaan       String?      @db.VarChar(100)
  metode_pengadaan      String?      @db.VarChar(50)
  urgensi               String?      @default("sedang") @db.VarChar(20)
  stage1_boq            String?
  stage1_hps            Decimal?     @db.Decimal(18,2)
  stage1_document_name  String?
  stage1_document_file_data String?
  stage1_document_file_path String?
  stage1_boq_file_data   String?
  stage1_boq_file_path   String?
  stage2_payment_method String?      @db.VarChar(20)
  stage2_payment_number Int?
  stage2_ls_date        DateTime?    @db.Date
  stage2_vendor         String?      @db.VarChar(150)
  stage2_invoice_number String?     @db.VarChar(100)
  stage2_invoice_date   DateTime?    @db.Date
  stage2_invoice_amount Decimal?     @db.Decimal(18,2)
  stage2_invoice_document_name String?
  stage2_invoice_document_file_data String?
  stage2_invoice_document_file_path String?
  stage3_documentation_names String?
  stage3_documentation_files String?
  stage3_documentation_file_paths String?
  stage3_bast_notes     String?
  catatan               String?
  created_by            Int?
  updated_by            Int?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  createdBy User? @relation("PemeliharaanCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PemeliharaanUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([status])
  @@map("pemeliharaan")
}

model Pengadaan {
  id                  Int          @id @default(autoincrement())
  kode                String       @unique @db.VarChar(30)
  nama_barang_jasa    String       @db.VarChar(255)
  kategori            String?      @db.VarChar(100)
  lokasi              String?      @db.VarChar(150)
  titik_lokasi        String?      @db.VarChar(255)
  metode_pengadaan    String?      @db.VarChar(50)
  nilai_hps           Decimal?     @db.Decimal(18,2)
  deskripsi           String?
  request_document_name String?
  request_document_file_data String?
  request_document_file_path String?
  stage2_payment_method String?    @db.VarChar(20)
  stage2_payment_number Int?
  stage2_ls_date      DateTime?    @db.Date
  stage2_vendor       String?      @db.VarChar(150)
  stage2_invoice_number String?    @db.VarChar(100)
  stage2_invoice_date DateTime?    @db.Date
  stage2_invoice_amount Decimal?   @db.Decimal(18,2)
  tanggal             DateTime     @default(now()) @db.Date
  status              StatusTahap  @default(pending)
  tanggal_selesai     DateTime?    @db.Date
  tahap1_status       StatusTahap  @default(pending)
  tahap2_status       StatusTahap  @default(pending)
  tahap3_status       StatusTahap  @default(pending)
  stage2_invoice_document_name String?
  stage2_invoice_document_file_data String?
  stage2_invoice_document_file_path String?
  stage2_invoice_file_data String?
  stage2_invoice_file_path String?
  stage2_payment_proof_name String?
  stage2_payment_proof_file_data String?
  stage2_payment_proof_file_path String?
  stage3_final_document_name String?
  stage3_final_document_file_data String?
  stage3_final_document_file_path String?
  catatan             String?
  created_by          Int?
  updated_by          Int?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  createdBy User? @relation("PengadaanCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PengadaanUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([status])
  @@map("pengadaan")
}

model Kendaraan {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(150)
  plate          String    @unique @db.VarChar(30)
  type           String    @db.VarChar(100)
  sub            String?   @db.VarChar(150)
  status         String    @default("Tersedia") @db.VarChar(30)
  tax            String?   @db.VarChar(50)
  next_tax       String?   @db.VarChar(50)
  photo_name     String?
  photo_file_data String?
  photo_file_path String?
  created_by     Int?
  updated_by     Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  createdBy User? @relation("KendaraanCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy User? @relation("KendaraanUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([plate])
  @@map("kendaraan")
}

model RuangRapat {
  id              Int       @id @default(autoincrement())
  agenda          String    @db.VarChar(255)
  room            String    @db.VarChar(150)
  pic             String    @db.VarChar(150)
  pic_phone       String    @db.VarChar(30)
  booking_date    DateTime  @db.Date
  start_time      DateTime  @db.Time(0)
  end_time        DateTime  @db.Time(0)
  surat_status    String    @default("belum") @db.VarChar(20)
  surat_name      String?   @db.VarChar(255)
  surat_file_data String?
  surat_file_path String?
  created_by      Int?
  updated_by      Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  createdBy User? @relation("RuangRapatCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RuangRapatUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([booking_date, room])
  @@index([pic])
  @@map("ruang_rapat")
}
